{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selena-birthday",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "keep_vars": true,
  "assets": {"directory": "./public","binding": "ASSETS"},
  "d1_databases": [{"binding":"DB","database_name":"selena-birthday-db","database_id":"REPLACE_WITH_D1_DATABASE_ID"}]
}